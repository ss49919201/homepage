{
  // TODO: ESLint でフォーマットする
  // デフォルトフォーマットターは Prettier
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // ファイル保存時、Prettier で自動フォーマット
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ]
}
